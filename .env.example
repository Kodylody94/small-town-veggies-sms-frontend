# Browser-visible frontend configuration. Use same-origin for the Vercel API router.
VITE_API_URL=same-origin
VITE_ENABLE_DEMO_DATA=true
VITE_ENABLE_LIVE_MUTATIONS=false

# Exact browser origin accepted by the backend. Use an origin only, without a path.
APP_ORIGIN=http://localhost:5173

# Generate a unique value of at least 32 characters. Never expose this through VITE_* variables.
SESSION_SECRET=

# Generate with: npm run admin:hash -- "a-long-unique-password"
ADMIN_PASSWORD_HASH=

# Eight hours by default.
SESSION_TTL_SECONDS=28800

# Keep false unless a reviewed same-site cross-origin deployment requires it.
ALLOW_SAME_SITE_REQUESTS=false

# Development uses in-memory session, rate-limit, and idempotency adapters for local tests only.
# Production fails closed until durable adapters and a database are explicitly connected.
BACKEND_RUNTIME_MODE=development

# Sandbox-only public order submission. Keep the provider credential server-only.
ENABLE_PUBLIC_ORDER_SUBMISSIONS=false
THREE_MIN_API_ENVIRONMENT=sandbox
THREE_MIN_API_URL=
THREE_MIN_API_SANDBOX_KEY=

# Reserved for the approved database-adapter stage.
DATABASE_URL=

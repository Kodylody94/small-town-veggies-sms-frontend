# Public base URL for the protected Small Town Veggies backend. Do not include a trailing slash.
VITE_API_URL=https://your-backend.example.com

# Set to true to preview the dashboard with clearly labeled sample data.
VITE_ENABLE_DEMO_DATA=true

# Keep false until authentication, authorization, audit logs, validation, and production tests pass.
VITE_ENABLE_LIVE_MUTATIONS=false
